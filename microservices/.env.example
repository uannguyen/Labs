# Khớp với infra/docker-compose.yml. Mỗi service một database riêng trên cùng Postgres.
KAFKA_BROKERS=localhost:9092

WALLET_PORT=3001
WALLET_DB_URL=postgres://lab:lab@localhost:5432/wallet

PAYMENT_PORT=3002
PAYMENT_DB_URL=postgres://lab:lab@localhost:5432/payment

PARTNER_PORT=3003
# Điều khiển hành vi giả lập ở phiên L3/L5: ok | fail | slow
PARTNER_MODE=ok
PARTNER_DELAY_MS=0

NOTIFICATION_PORT=3004
NOTIFICATION_DB_URL=postgres://lab:lab@localhost:5432/notification
